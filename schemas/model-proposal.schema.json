{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/schemas/model-proposal.schema.json",
  "title": "Constrained model extraction proposal",
  "type": "object",
  "required": ["criterionType", "normalizedPredicate", "sourceSpan", "confidence", "ambiguities", "modelVersion"],
  "properties": {
    "criterionType": { "type": "string" },
    "normalizedPredicate": { "$ref": "#/$defs/predicate" },
    "sourceSpan": {
      "type": "object",
      "required": ["start", "end", "text"],
      "properties": {
        "start": { "type": "integer", "minimum": 0 },
        "end": { "type": "integer", "minimum": 0 },
        "text": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "ambiguities": { "type": "array", "items": { "type": "string" } },
    "modelVersion": { "type": "string", "minLength": 1 }
  },
  "additionalProperties": false,
  "$defs": {
    "predicate": {
      "oneOf": [
        {
          "type": "object",
          "required": ["op", "concept", "predicate", "operator"],
          "properties": {
            "op": { "const": "FACT" },
            "concept": { "type": "string", "minLength": 1 },
            "predicate": { "type": "string", "minLength": 1 },
            "operator": { "enum": ["EQ", "NE", "IN", "NOT_IN", "GT", "GE", "LT", "LE"] },
            "value": {},
            "assertion": { "type": "string" },
            "unit": { "type": "string" },
            "label": { "type": "string" },
            "question": { "type": "string" }
          },
          "anyOf": [{ "required": ["value"] }, { "required": ["assertion"] }],
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["op", "args"],
          "properties": {
            "op": { "enum": ["AND", "ALL_OF", "OR", "ANY_OF", "NONE_OF", "NOT"] },
            "args": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/predicate" } },
            "label": { "type": "string" }
          },
          "additionalProperties": false
        }
      ]
    }
  }
}
